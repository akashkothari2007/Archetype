          "default": "feet",
          "title": "Units",
          "type": "string"
        },
        "floors": {
          "items": {
            "$ref": "#/$defs/Floor"
          },
          "title": "Floors",
          "type": "array"
        },
        "vertices": {
          "items": {
            "$ref": "#/$defs/Vertex"
          },
          "title": "Vertices",
          "type": "array"
        },
        "walls": {
          "items": {
            "$ref": "#/$defs/BuildingWall"
          },
          "title": "Walls",
          "type": "array"
        },
        "openings": {
          "items": {
            "$ref": "#/$defs/Opening"
          },
          "title": "Openings",
          "type": "array"
        },
        "rooms": {
          "items": {
            "$ref": "#/$defs/Room"
          },
          "title": "Rooms",
          "type": "array"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/PlacedObject"
          },
          "title": "Objects",
          "type": "array"
        },
        "type_catalogue": {
          "items": {
            "$ref": "#/$defs/TypeCatalogueEntry"
          },
          "title": "Type Catalogue",
          "type": "array"
        },
        "environment": {
          "$ref": "#/$defs/Environment"
        },
        "review": {
          "items": {
            "$ref": "#/$defs/ReviewItem"
          },
          "title": "Review",
          "type": "array"
        }
      },
      "title": "Building",
      "type": "object",
      "required": [
        "schema_version",
        "units",
        "floors",
        "vertices",
        "walls",
        "openings",
        "rooms",
        "objects",
        "type_catalogue",
        "environment",
        "review"
      ]
    },
    "BuildingWall": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "floor_id": {
          "title": "Floor Id",
          "type": "string"
        },
        "start_id": {
          "title": "Start Id",
          "type": "string"
        },
        "end_id": {
          "title": "End Id",
          "type": "string"
        },
        "thickness_ft": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Thickness Ft",
          "type": "number"
        },
        "height_ft": {
          "default": 9,
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Height Ft",
          "type": "number"
        },
        "structural": {
          "default": "unknown",
          "enum": [
            "loadbearing",
            "nonstructural",
            "unknown"
