          "title": "Structural",
          "type": "string"
        },
        "locked": {
          "default": true,
          "title": "Locked",
          "type": "boolean"
        },
        "material": {
          "default": "plaster",
          "title": "Material",
          "type": "string"
        },
        "confidence": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
