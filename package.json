{
  "name": "plancheck",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd apps/api && uv run uvicorn app.main:app --reload --port 8000",
    "dev:web": "npm run dev -w @plancheck/web",
    "build": "npm run build -w @plancheck/web",
    "typecheck": "npm run typecheck -w @plancheck/web",
    "setup": "npm install && cd apps/api && uv sync"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
