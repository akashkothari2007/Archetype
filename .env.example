PLANCHECK_DATA_DIR=./local-data/projects
PLANCHECK_ENGINES=classify:real,extract:real,model:real,rules:real,check:real,agent:stub
PLANCHECK_AGENT_PROVIDER=baseten
# demo = fixed two-storey house. baseten = plan the building from the prompt.
PLANCHECK_GENERATION_PROVIDER=demo
PLANCHECK_USE_ENLARGED=false
PLANCHECK_AUTO_APPROVE=true
# INFO shows agent flow + full prompts/replies in `docker compose logs -f backend`
PLANCHECK_LOG_LEVEL=INFO

# Paste your Baseten API key on the next line (app.baseten.co → API keys)
BASETEN_API_KEY=

# GLM for planning / generation (prefer JSON over chain-of-thought models)
PLANCHECK_ORCHESTRATOR_MODEL=zai-org/GLM-5.3-Flash
PLANCHECK_SUBAGENT_MODEL=zai-org/GLM-5.3-Flash
PLANCHECK_GENERATION_MODEL=zai-org/GLM-5.3-Flash
PLANCHECK_AGENT_BASE_URL=https://inference.baseten.co/v1
